{
  "name": "redone-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run sync:images && next dev",
    "clean": "rm -rf .next",
    "sync:images": "node scripts/sync-static-images.mjs",
    "sync:init-notes": "node scripts/sync-static-images.mjs --init-notes",
    "prebuild": "npm run sync:images",
